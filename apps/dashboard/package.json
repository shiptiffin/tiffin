{
  "name": "@tiffin/dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . && node scripts/check-overrides.mjs",
    "check:overrides": "node scripts/check-overrides.mjs",
    "test": "bun test && tsc --noEmit -p test/tsconfig.json",
    "gen:api": "cd ../.. && TIFFIN_OPENAPI_OUT=\"$PWD/apps/dashboard/node_modules/.cache/openapi.json\" go test ./cmd/tiffin -run '^TestWriteOpenAPI$' -count=1 >/dev/null && cd apps/dashboard && openapi-typescript node_modules/.cache/openapi.json -o src/api/schema.d.ts",
    "gen:api:box": "openapi-typescript ${TIFFIN_URL:-http://127.0.0.1:7391}/v1/openapi.json -o src/api/schema.d.ts",
    "e2e": "playwright test --workers=1"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/commit-mono": "^5.0.0",
    "@lezer/highlight": "^1.2.5",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.0.0",
    "@tanstack/react-virtual": "^3.14.13",
    "cmdk": "^1.0.0",
    "d3-geo": "^3.1.1",
    "d3-shape": "^3.2.0",
    "lucide-react": "^1.51.0",
    "radix-ui": "^1.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-shape": "^3.2.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^17.0.0",
    "openapi-typescript": "^7.0.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.3.2"
  }
}
