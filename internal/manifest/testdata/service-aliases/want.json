{
  "version": 1,
  "project": "aliases",
  "apps": {
    "web": {
      "path": ".",
      "framework": "next",
      "role": "web",
      "routes": [
        "aliases"
      ],
      "instances": 1,
      "healthcheck": "/"
    }
  },
  "services": {
    "postgres": {
      "extensions": [
        "vector"
      ]
    },
    "valkey": {
      "maxMemoryMB": 32
    },
    "storage": {
      "buckets": {
        "files": {
          "public": false
        },
        "photos": {
          "public": false
        }
      }
    },
    "email": {},
    "analytics": {
      "retentionDays": 365
    }
  }
}
