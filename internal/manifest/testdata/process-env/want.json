{
  "version": 1,
  "project": "envy-prod",
  "apps": {
    "web": {
      "path": ".",
      "framework": "bun",
      "role": "web",
      "routes": [
        "envy-prod"
      ],
      "instances": 1,
      "healthcheck": "/"
    }
  },
  "services": {
    "postgres": {},
    "valkey": {
      "maxMemoryMB": 64
    },
    "storage": {
      "buckets": {
        "files": {
          "public": false
        }
      }
    },
    "email": {},
    "analytics": {
      "retentionDays": 365
    }
  },
  "env": {
    "GREETING": "hi there",
    "STAGE": "prod"
  }
}
