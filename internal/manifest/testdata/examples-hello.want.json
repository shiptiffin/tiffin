{
  "version": 1,
  "project": "hello",
  "apps": {
    "api": {
      "path": "apps/api",
      "framework": "hono",
      "role": "web",
      "routes": [
        "hello/api"
      ],
      "instances": 2,
      "healthcheck": "/healthz",
      "env": {
        "CORS_ORIGIN": "https://hello"
      }
    },
    "web": {
      "path": "apps/web",
      "framework": "next",
      "role": "web",
      "routes": [
        "hello"
      ],
      "instances": 1,
      "memoryMB": 1024,
      "healthcheck": "/"
    },
    "worker": {
      "path": "apps/worker",
      "framework": "bun",
      "role": "worker",
      "instances": 1,
      "memoryMB": 256
    }
  },
  "services": {
    "postgres": {
      "extensions": [
        "vector"
      ]
    },
    "valkey": {
      "maxMemoryMB": 128
    },
    "storage": {
      "buckets": {
        "uploads": {
          "public": true
        }
      }
    },
    "auth": {
      "methods": [
        "email",
        "google",
        "magic-link"
      ],
      "organizations": true
    },
    "email": {
      "from": "hello@example.com"
    },
    "analytics": {
      "retentionDays": 90
    }
  },
  "crons": {
    "nightly-report": {
      "schedule": "0 3 * * *",
      "app": "worker",
      "path": "/cron/report"
    }
  },
  "queues": {
    "audit": {
      "app": "worker",
      "path": "/events/audit",
      "concurrency": 0,
      "keyConcurrency": 0,
      "rateLimit": 0,
      "ratePeriodSeconds": 0,
      "maxAttempts": 8,
      "leaseSeconds": 60
    },
    "emails": {
      "app": "worker",
      "path": "/queues/emails",
      "concurrency": 4,
      "keyConcurrency": 0,
      "rateLimit": 0,
      "ratePeriodSeconds": 0,
      "maxAttempts": 5,
      "leaseSeconds": 60
    }
  },
  "topics": {
    "order.created": {
      "subscribers": [
        "audit",
        "emails"
      ]
    }
  },
  "env": {
    "LOG_LEVEL": "info"
  }
}
