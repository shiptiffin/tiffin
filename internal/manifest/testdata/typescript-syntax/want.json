{
  "version": 1,
  "project": "typed",
  "apps": {
    "api": {
      "path": ".",
      "framework": "hono",
      "role": "web",
      "routes": [
        "api"
      ],
      "instances": 1,
      "memoryMB": 256,
      "healthcheck": "/"
    },
    "web": {
      "path": ".",
      "framework": "next",
      "role": "web",
      "routes": [
        "typed"
      ],
      "instances": 1,
      "memoryMB": 2048,
      "healthcheck": "/"
    }
  },
  "services": {
    "postgres": {},
    "valkey": {
      "maxMemoryMB": 64
    },
    "storage": {
      "buckets": {
        "files": {
          "public": false
        }
      }
    },
    "email": {},
    "analytics": {
      "retentionDays": 365
    }
  },
  "env": {
    "REGION": "eu"
  }
}
