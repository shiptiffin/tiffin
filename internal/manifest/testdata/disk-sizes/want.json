{
  "version": 1,
  "project": "media",
  "apps": {
    "same": {
      "path": ".",
      "framework": "bun",
      "role": "web",
      "routes": [
        "media-same"
      ],
      "instances": 1,
      "healthcheck": "/",
      "disk": [
        "data"
      ]
    },
    "web": {
      "path": ".",
      "framework": "bun",
      "role": "web",
      "routes": [
        "media"
      ],
      "instances": 1,
      "healthcheck": "/",
      "disk": {
        "cache": "1GB",
        "data": "5GB",
        "renders/out": "2GB",
        "tmp": "500MB"
      },
      "timeoutSeconds": 7200
    }
  },
  "services": {
    "postgres": {},
    "valkey": {
      "maxMemoryMB": 64
    },
    "storage": {
      "buckets": {
        "files": {
          "public": false
        }
      }
    },
    "email": {},
    "analytics": {
      "retentionDays": 365
    }
  }
}
