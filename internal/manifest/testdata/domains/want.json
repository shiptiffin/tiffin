{
  "version": 1,
  "project": "shop",
  "apps": {
    "api": {
      "path": ".",
      "framework": "bun",
      "role": "web",
      "routes": [
        "example.com/api"
      ],
      "instances": 1,
      "healthcheck": "/"
    },
    "web": {
      "path": ".",
      "framework": "bun",
      "role": "web",
      "routes": [
        "web",
        "example.com"
      ],
      "instances": 1,
      "healthcheck": "/"
    }
  },
  "services": {
    "postgres": {},
    "valkey": {
      "maxMemoryMB": 64
    },
    "storage": {
      "buckets": {
        "files": {
          "public": false
        }
      }
    },
    "email": {},
    "analytics": {
      "retentionDays": 365
    }
  },
  "domains": {
    "example.com": {
      "www": "redirect"
    }
  }
}
