{
  "version": 1,
  "project": "bundled",
  "apps": {
    "admin": {
      "path": ".",
      "framework": "next",
      "role": "web",
      "routes": [
        "admin.example.com"
      ],
      "instances": 2,
      "memoryMB": 768,
      "healthcheck": "/"
    },
    "web": {
      "path": ".",
      "framework": "next",
      "role": "web",
      "routes": [
        "www.example.com"
      ],
      "instances": 1,
      "memoryMB": 768,
      "healthcheck": "/"
    }
  },
  "services": {
    "postgres": {},
    "valkey": {
      "maxMemoryMB": 64
    },
    "storage": {
      "buckets": {
        "files": {
          "public": false
        }
      }
    },
    "email": {},
    "analytics": {
      "retentionDays": 365
    }
  }
}
