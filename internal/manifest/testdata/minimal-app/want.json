{
  "version": 1,
  "project": "blog",
  "apps": {
    "web": {
      "path": ".",
      "framework": "next",
      "role": "web",
      "routes": [
        "blog"
      ],
      "instances": 1,
      "healthcheck": "/"
    }
  },
  "services": {
    "postgres": {},
    "valkey": {
      "maxMemoryMB": 64
    },
    "storage": {
      "buckets": {
        "files": {
          "public": false
        }
      }
    },
    "email": {},
    "analytics": {
      "retentionDays": 365
    }
  }
}
