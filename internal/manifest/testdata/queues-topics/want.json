{
  "version": 1,
  "project": "shop",
  "apps": {
    "jobs": {
      "path": "apps/jobs",
      "framework": "bun",
      "role": "worker",
      "instances": 1
    },
    "web": {
      "path": "apps/web",
      "framework": "next",
      "role": "web",
      "routes": [
        "shop"
      ],
      "instances": 1,
      "healthcheck": "/"
    }
  },
  "services": {
    "postgres": {},
    "valkey": {
      "maxMemoryMB": 64
    },
    "storage": {
      "buckets": {
        "files": {
          "public": false
        }
      }
    },
    "email": {},
    "analytics": {
      "retentionDays": 365
    }
  },
  "queues": {
    "audit": {
      "app": "web",
      "path": "/queues/audit",
      "concurrency": 0,
      "keyConcurrency": 0,
      "rateLimit": 5,
      "ratePeriodSeconds": 10,
      "maxAttempts": 10,
      "leaseSeconds": 60
    },
    "emails": {
      "app": "jobs",
      "path": "/queues/emails",
      "concurrency": 0,
      "keyConcurrency": 0,
      "rateLimit": 0,
      "ratePeriodSeconds": 0,
      "maxAttempts": 10,
      "leaseSeconds": 60
    },
    "image-resize": {
      "app": "jobs",
      "path": "/jobs/resize",
      "concurrency": 4,
      "keyConcurrency": 1,
      "rateLimit": 30,
      "ratePeriodSeconds": 60,
      "maxAttempts": 3,
      "leaseSeconds": 600
    }
  },
  "topics": {
    "order.created": {
      "subscribers": [
        "audit",
        "emails"
      ]
    },
    "order.shipped": {
      "subscribers": [
        "emails"
      ]
    },
    "user.deleted": {}
  }
}
