      "default": "./lib/config.js"
    },
    "./kv": {
      "types": "./lib/kv.d.ts",
      "default": "./lib/kv.js"
    },
    "./analytics": {
      "types": "./lib/analytics.d.ts",
      "default": "./lib/analytics.js"
    },
    "./vitals": {
      "types": "./lib/vitals.d.ts",
      "default": "./lib/vitals.js"
    },
    "./storage": {
      "types": "./lib/storage.d.ts",
      "default": "./lib/storage.js"
    },
    "./storage/client": {
      "types": "./lib/storage-client.d.ts",
      "default": "./lib/storage-client.js"
    },
    "./email": {
      "types": "./lib/email.d.ts",
      "default": "./lib/email.js"
