  "dependencies": {
    "nodemailer": "^10.0.13"
  },
  "peerDependencies": {
    "@tiffin/react": "0.1.0",
    "@react-email/render": ">=1",
    "next": ">=15",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "@tiffin/react": {
      "optional": true
    },
    "@react-email/render": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
