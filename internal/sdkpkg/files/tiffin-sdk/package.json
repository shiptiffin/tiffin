{
  "name": "tiffin-sdk",
  "version": "0.1.0",
  "description": "Config types and helpers for Tiffin, the agent-first app-in-a-box platform.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
