{
  "name": "tiffin-sdk",
  "version": "0.0.0",
  "description": "Config types and helpers for Tiffin, the agent-first app-in-a-box platform.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": ["src"],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./config": {
      "types": "./src/config.ts",
      "default": "./src/config.ts"
    },
    "./db": {
      "types": "./src/db.ts",
      "default": "./src/db.ts"
    },
    "./kv": {
      "types": "./src/kv.ts",
      "default": "./src/kv.ts"
    },
    "./analytics": {
      "types": "./src/analytics.ts",
      "default": "./src/analytics.ts"
    },
    "./storage": {
      "types": "./src/storage.ts",
      "default": "./src/storage.ts"
    },
    "./email": {
      "types": "./src/email.ts",
      "default": "./src/email.ts"
    },
    "./next": {
      "types": "./src/next/index.ts",
      "default": "./src/next/index.ts"
    },
    "./next/cache-handler": {
      "types": "./src/next/cache-handler.ts",
      "default": "./src/next/cache-handler.ts"
    },
    "./next/use-cache": {
      "types": "./src/next/use-cache.ts",
      "default": "./src/next/use-cache.ts"
    },
    "./queue": {
      "types": "./src/queue.ts",
      "default": "./src/queue.ts"
    },
    "./workflow": {
      "types": "./src/workflow.ts",
      "default": "./src/workflow.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "bun test"
  },
  "dependencies": {
    "nodemailer": "^10.0.13"
  },
  "devDependencies": {
    "@react-email/render": "^2.1.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/smtp-server": "^3.5.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "smtp-server": "^3.19.16"
  },
  "peerDependencies": {
    "@react-email/render": ">=1",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@react-email/render": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
