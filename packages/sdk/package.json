{
  "name": "@shiptiffin/sdk",
  "version": "0.2.0",
  "description": "The SDK for apps on a ShipTiffin box: config, KV (Valkey), file storage, queues, durable workflows, auth, email, analytics and Next.js helpers, with nothing to set up.",
  "license": "Apache-2.0",
  "author": "ShipTiffin <hello@shiptiffin.com> (https://shiptiffin.com)",
  "homepage": "https://shiptiffin.com",
  "repository": { "type": "git", "url": "git+https://github.com/shiptiffin/tiffin.git", "directory": "packages/sdk" },
  "bugs": { "url": "https://github.com/shiptiffin/tiffin/issues", "email": "hello@shiptiffin.com" },
  "keywords": [
    "tiffin", "shiptiffin", "self-hosted", "nextjs", "bun", "valkey", "redis", "kv", "s3", "storage",
    "queue", "background-jobs", "workflow", "better-auth", "auth", "email", "react-email", "analytics", "web-vitals"
  ],
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=20" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./config": { "types": "./dist/config.d.ts", "default": "./dist/config.js" },
    "./kv": { "types": "./dist/kv.d.ts", "default": "./dist/kv.js" },
    "./analytics": { "types": "./dist/analytics.d.ts", "default": "./dist/analytics.js" },
    "./vitals": { "types": "./dist/vitals.d.ts", "default": "./dist/vitals.js" },
    "./storage": { "types": "./dist/storage.d.ts", "default": "./dist/storage.js" },
    "./client": { "types": "./dist/client/index.d.ts", "default": "./dist/client/index.js" },
    "./email": { "types": "./dist/email.d.ts", "default": "./dist/email.js" },
    "./queue": { "types": "./dist/queue.d.ts", "default": "./dist/queue.js" },
    "./workflow": { "types": "./dist/workflow.d.ts", "default": "./dist/workflow.js" },
    "./verify": { "types": "./dist/verify.d.ts", "default": "./dist/verify.js" },
    "./auth": { "types": "./dist/auth.d.ts", "default": "./dist/auth.js" },
    "./next": { "types": "./dist/next/index.d.ts", "default": "./dist/next/index.js" },
    "./next/auth": { "types": "./dist/next/auth.d.ts", "default": "./dist/next/auth.js" },
    "./next/cache-handler": { "types": "./dist/next/cache-handler.d.ts", "default": "./dist/next/cache-handler.js" },
    "./next/use-cache": { "types": "./dist/next/use-cache.d.ts", "default": "./dist/next/use-cache.js" },
    "./next/image-loader": { "types": "./dist/next/image-loader.d.ts", "default": "./dist/next/image-loader.js" },
    "./next/vitals": { "types": "./dist/next/vitals.d.ts", "default": "./dist/next/vitals.js" },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "check:pack": "bun run build && npm pack --dry-run",
    "typecheck": "tsc --noEmit -p .",
    "test": "bun test"
  },
  "dependencies": {
    "altcha-lib": "^2.6.0",
    "nodemailer": "^10.0.15"
  },
  "devDependencies": {
    "@react-email/render": "^2.1.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/smtp-server": "^3.5.13",
    "next": "16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "smtp-server": "^3.19.16"
  },
  "peerDependencies": {
    "@react-email/render": ">=1",
    "better-auth": ">=1.7",
    "next": ">=15",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@react-email/render": { "optional": true },
    "better-auth": { "optional": true },
    "next": { "optional": true },
    "react": { "optional": true }
  }
}
